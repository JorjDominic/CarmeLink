# Copy this file to supabase/functions/.env for local development only.
# Never commit the real .env file.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=CarmeLink <onboarding@your-verified-domain.example>
# Optional. Must also be allowed in Supabase Auth > URL Configuration.
APP_INVITE_REDIRECT_URL=https://your-app.example/onboarding

<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application>
        <!-- Debug-only hook for verifying background notification delivery
             without opening the Flutter activity. Never merged into release. -->
        <receiver
            android:name=".DebugNotificationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.carmelita.carmelink.DEBUG_TEST_NOTIFICATION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
